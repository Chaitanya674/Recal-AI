MOCK=                       # 1 = canned replies (no Google Cloud calls)
SESSION_SECRET=change-me

# --- Google Cloud (Vertex AI Gemini + Firestore + Cloud Storage) ---
# Every model call runs on Vertex AI, billed to this project. Auth is ADC: on the VM
# it is the attached service account; locally run `gcloud auth application-default login`.
# Setting GOOGLE_CLOUD_PROJECT also switches ALL storage to Firestore (events, chat,
# cards, knowledge graph + embeddings, uploads, tokens). Unset = mock + local fallback.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global   # Gemini 3.x Pro/TTS are served from "global" only
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json   # local dev only; never on the VM
GOOGLE_CLOUD_API_KEY=          # optional Vertex AI API key: Gemini only; blank = service account

# --- Gemini models (blank = these defaults) ---
MODEL_LITE=gemini-3.5-flash-lite      # routing: intent / guard / style, temperature 0
MODEL_FAST=gemini-3.8-flash           # chat, reels, pages, doc review
MODEL_DEEP=gemini-3.1-pro-preview     # planning, reel visual direction, escalations
MODEL_EMBED=gemini-embedding-001      # 768-dim vectors (Firestore vector index)

# --- Reels ---
MODEL_TTS=gemini-3.8-flash-tts            # Gemini TTS narration; empty = captions only
MODEL_TTS_FALLBACK=gemini-3.8-flash-lite-tts  # tried on 429/404 (separate quota pool)
TTS_VOICE=Kore                            # any prebuilt Gemini TTS voice
LOCAL_TTS=1                               # offline system-voice fallback (pyttsx3); 0 = off
REEL_MIN_SIMILARITY=0.6                   # cosine floor for "this passage is about the topic"

# --- Persistence extras (docs/firestore-design.md) ---
RECAL_MEDIA_BUCKET=            # GCS bucket for reel MP4/WAV/PDF + uploaded originals
RECAL_ENCRYPTION_KEY=          # 32 random bytes, base64: AES-256-GCM for stored OAuth tokens
RECAL_KMS_KEY=                 # optional: projects/<p>/locations/<l>/keyRings/recal/cryptoKeys/recal-secrets

# --- Google Calendar (read) + Docs (export): OAuth "Web application" client ---
# Register the redirect URI  <OAUTH_REDIRECT_BASE>/api/connect/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_BASE=http://localhost:8000
MAX_STUDY_MIN_PER_DAY=150
